<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cubic_spline_smoothing_adapter</name>
  <version>0.0.0</version>
  <description>Package for re-calculating vel/acc of trajectories from moveit based on cubic splines.</description>
  <author email="nikola.banovic@b-robotized.com">Nikola Banovic</author>
  <maintainer email="nikola.banovic@b-robotized.com">Nikola Banovic</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>moveit_core</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
